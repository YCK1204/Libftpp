CompileFlags:
  # compile_commands.json이 없을 때 쓰는 플래그 (Makefile과 동일하게)
  Add:
    - -xc++
    - -std=c++11
    - -Wall
    - -Wextra
    - -Werror
    - -I/home/yeckim/Libftpp
    - -I/home/yeckim/Libftpp/header
  Compiler: c++
Index:
  StandardLibrary: Yes
Documentation:
  CommentFormat: Doxygen
Hover:
  ShowAKA: No
Completion:
  # 함수 선택 시 인자 자리(placeholder)까지만 채움
  ArgumentLists: FullPlaceholders
Diagnostics:
  # 컴파일러(-Wall -Wextra) 경고만 표시, clang-tidy / include 정리 경고는 끔
  UnusedIncludes: None
  MissingIncludes: None
  ClangTidy:
    Remove: '*'
